FROM rust:1-bookworm AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock* ./
COPY server ./server
COPY tests ./tests

RUN cargo build --release --package sinopec-server

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 libsqlite3-0 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/sinopec-server /usr/local/bin/sinopec-server
COPY server/src/api/human_ui_template.html /app/server/src/api/human_ui_template.html

VOLUME ["/data"]
ENV SINOPEC_BIND=0.0.0.0:8788
ENV SINOPEC_DATA_DIR=/data
ENV RUST_LOG=info

EXPOSE 8788
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD curl -fsS http://127.0.0.1:8788/api/v1/health || exit 1

ENTRYPOINT ["/usr/local/bin/sinopec-server"]
